# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 示例文件要进仓库（它不含真 key，只是说明要填哪些变量）
!.env.example

# 密钥绝对不进仓库——仓库是公开的
*.key
secrets.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 本机自动验证脚本生成的截图与临时浏览器配置
/.shots/

# 外部收到的审阅材料（含他人原型原件，勿上传到公开仓库）
/_review/
/.dsh-drop/

